# NexLink Relay Server — Environment Variables
# Copy this to .env and fill in your values

# Firebase Service Account JSON (paste the entire JSON as a single line, or use Render's env var UI)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"nexlink-62e41",...}

# Firebase Realtime Database URL
FIREBASE_DATABASE_URL=https://nexlink-62e41-default-rtdb.firebaseio.com/

# Port (Render.com sets this automatically — do not change)
PORT=3000

# Node environment
NODE_ENV=production

