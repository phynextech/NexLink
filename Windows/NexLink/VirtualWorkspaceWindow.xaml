<Window x:Class="NexLink.VirtualWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NexLink Extended Display" Height="720" Width="1280"
        WindowStyle="None" AllowsTransparency="True" Background="#121212"
        Topmost="True" ShowInTaskbar="False">
    <Grid>
        <Border BorderBrush="#333333" BorderThickness="2" CornerRadius="0">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="NEXLINK VIRTUAL WORKSPACE" Foreground="#555555" FontSize="24" FontWeight="Bold" FontFamily="Rajdhani, Segoe UI" HorizontalAlignment="Center" />
                <TextBlock Text="This area is being streamed to your phone." Foreground="#444444" FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
        
        <!-- Draggable Header for repositioning if needed -->
        <Border Height="30" VerticalAlignment="Top" Background="Transparent" MouseLeftButtonDown="Header_MouseDown" Cursor="SizeAll"/>
    </Grid>
</Window>
