<Window x:Class="NexLink.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="400" Width="400"
        Background="#121212"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterOwner">
    <Border BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="12" Background="#1B1B1B">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="⚙" FontSize="20" Foreground="#FFFFFF" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="SETTINGS" FontFamily="Rajdhani, Segoe UI" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <TextBlock Text="SYSTEM" FontFamily="Rajdhani" FontSize="12" FontWeight="Bold" Foreground="#848484" Margin="0,0,0,12"/>
                <CheckBox x:Name="AutoStartCheckbox" Content="Run NexLink on startup (Background)" Foreground="#DFDFDF" Margin="0,0,0,24" Click="AutoStart_Click"/>

                <TextBlock Text="LINKED DEVICES" FontFamily="Rajdhani" FontSize="12" FontWeight="Bold" Foreground="#848484" Margin="0,0,0,12"/>
                <Border Background="#1A1A1A" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Feature coming soon..." Foreground="#848484" FontStyle="Italic"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Button Grid.Row="2" Content="Close" Background="#2A2A2A" Foreground="#FFFFFF" BorderThickness="0" Padding="16,8" HorizontalAlignment="Right" Click="Close_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Border>
</Window>
