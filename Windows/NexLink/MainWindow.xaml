<Window x:Class="NexLink.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:NexLink.Helpers"
        mc:Ignorable="d"
        Title="NexLink" Height="760" Width="1200"
        MinHeight="600" MinWidth="900"
        Background="#000000"
        WindowStyle="None"
        AllowsTransparency="True"
        Icon="Assets/app.png"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- NOTE: BoolToVisibility, BoolToAlignment, BoolToColor are in App.xaml -->
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="#121212" Opacity="0.6"/>
                </Setter.Value>
            </Setter>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <SolidColorBrush Color="White" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Notification item template -->
        <DataTemplate x:Key="NotifTemplate">
            <Border CornerRadius="12" Margin="0,0,0,12" Padding="1" BorderBrush="#252525" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <!-- Glass Background using Mobile Wallpaper -->
                    <Border CornerRadius="11">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding ElementName=MobileWallpaperImage, Path=Source}" Stretch="UniformToFill" Opacity="0.15"/>
                        </Border.Background>
                        <Border.Effect>
                            <BlurEffect Radius="20"/>
                        </Border.Effect>
                    </Border>
                    <Border Background="#1A000000" CornerRadius="11" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="20" Height="20" Background="#3D5AFE" CornerRadius="4">
                                    <TextBlock Text="📱" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding AppName}" Foreground="#B0B0B0" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Timestamp, StringFormat={}{0:HH:mm}}" Foreground="#666666" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Grid.Column="3" Content="✕" Style="{StaticResource IconButton}" FontSize="10" Foreground="#848484" Width="20" Height="20" Click="DismissNotif_Click" Tag="{Binding}"/>
                            </Grid>

                            <TextBlock Grid.Row="1" Text="{Binding Title}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Row="2" Text="{Binding Body}" Foreground="#B0B0B0" FontSize="12" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- SMS thread template -->
        <DataTemplate x:Key="SmsThreadTemplate">
            <Border Padding="12,10" Background="Transparent" Cursor="Hand">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#33FFFFFF">
                        <TextBlock Text="{Binding ContactName[0]}" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ContactName}" FontWeight="SemiBold" FontSize="13" Foreground="#DFDFDF"/>
                        <TextBlock Text="{Binding LastMessage}" Foreground="#BBBBBB" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm}}" Foreground="#848484" FontSize="11"/>
                        <Border Background="#FFFFFF" CornerRadius="10" Padding="6,2" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Unread}" FontSize="11" Foreground="#0A0A0A" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        
        <Style x:Key="NavListItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#BBBBBB"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="BgBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#1AFFFFFF"/>
                                <Setter Property="Foreground" Value="#DFDFDF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#1AFFFFFF"/>
                                <Setter TargetName="BgBorder" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="BgBorder" Property="BorderThickness" Value="3,0,0,0"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- DOT GRID BACKGROUND BRUSH -->
        <Grid.Background>
            <DrawingBrush Viewport="0,0,24,24" ViewportUnits="Absolute" TileMode="Tile">
                <DrawingBrush.Drawing>
                    <GeometryDrawing Brush="#08FFFFFF">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry RadiusX="1.5" RadiusY="1.5" Center="12,12" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingBrush.Drawing>
            </DrawingBrush>
        </Grid.Background>

        <Border x:Name="ConnectedDashboard" Visibility="Collapsed" Background="#000000" BorderBrush="#252525" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#111111" BorderBrush="#1AFFFFFF" BorderThickness="0,0,1,0" Padding="16,24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Logo -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,0,0,32">
                        <Border Background="#1AFFFFFF" CornerRadius="8" Width="32" Height="32" Margin="0,0,12,0">
                            <TextBlock Text="⚡" Foreground="#FFFFFF" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="NEXLINK" FontFamily="Rajdhani, Segoe UI" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="SYSTEM SYNCED" FontFamily="JetBrains Mono, Consolas" FontSize="10" Foreground="#FFFFFF" Opacity="0.8"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Nav -->
                    <ListBox Grid.Row="1" x:Name="NavListBox" Background="Transparent" BorderThickness="0" SelectedIndex="0" ItemContainerStyle="{StaticResource NavListItem}">
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏠" Margin="0,0,12,0"/>
                                <TextBlock Text="Home Dashboard" FontFamily="Rajdhani, Segoe UI" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💬" Margin="0,0,12,0"/>
                                <TextBlock Text="Messages" FontFamily="Rajdhani, Segoe UI" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖼️" Margin="0,0,12,0"/>
                                <TextBlock Text="Photos" FontFamily="Rajdhani, Segoe UI" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💠" Margin="0,0,12,0"/>
                                <TextBlock Text="Apps" FontFamily="Rajdhani, Segoe UI" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" Margin="0,0,12,0"/>
                                <TextBlock Text="Clipboard" FontFamily="Rajdhani, Segoe UI" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💬" Margin="0,0,12,0"/>
                                <TextBlock Text="Chat" FontFamily="Rajdhani, Segoe UI" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" Margin="0,0,12,0"/>
                                <TextBlock Text="Settings" FontFamily="Rajdhani, Segoe UI" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <!-- Status -->
                    <Border Grid.Row="2" BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0" Padding="8,24,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Fill>
                                        <SolidColorBrush x:Name="StatusDotBrush" Color="#848484"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock x:Name="StatusLabel" Text="Disconnected" Foreground="#848484" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="StatusBar" Text="Ready" Foreground="#848484" FontSize="12"/>
                            <TextBlock x:Name="PortLabel" Foreground="#848484" FontSize="12" Margin="0,4,0,0"/>
                            <TextBlock Text="Powered by Phynex" Foreground="#33FFFFFF" FontSize="10" Margin="0,16,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Column="1" Background="#000000">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title Bar -->
                <Border Grid.Row="0" Background="#111111" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1" Padding="24,0">
                    <Grid MouseLeftButtonDown="TitleBar_MouseDown" Background="Transparent">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Dashboard" FontFamily="Rajdhani, Segoe UI" FontSize="20" FontWeight="SemiBold" Foreground="#DFDFDF" Margin="0,0,16,0"/>
                            <Border Background="#0DFFFFFF" CornerRadius="4" Padding="8,4">
                                <TextBlock Text="Last synced: just now" FontFamily="JetBrains Mono" FontSize="10" Foreground="#BBBBBB"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="─" Style="{StaticResource IconButton}" Click="Minimize_Click" Foreground="#848484" FontSize="14" Width="32" Height="32"/>
                            <Button Content="✕" Style="{StaticResource IconButton}" Click="Close_Click" Foreground="#848484" FontSize="13" Width="32" Height="32"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tabs corresponding to Nav -->
                <TabControl Grid.Row="1" x:Name="MainTabs" Background="Transparent" BorderThickness="0" SelectedIndex="{Binding ElementName=NavListBox, Path=SelectedIndex}">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Style>
                    </TabControl.ItemContainerStyle>
                    
                    <!-- TAB 0: HOME DASHBOARD (Cyber-Premium 3-column) -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Col 1: Device Control -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">

                                    
                                    <Border x:Name="PhoneInfoPanel" Style="{StaticResource GlassCard}" Padding="24" Visibility="Collapsed" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="MOBILE PREVIEW" FontFamily="Rajdhani" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,16"/>
                                            <Border Background="#1A1A1A" CornerRadius="24" BorderBrush="#313131" BorderThickness="4" Width="160" Height="320" HorizontalAlignment="Center">
                                                <Grid>
                                                    <Image x:Name="MobileWallpaperImage" Stretch="UniformToFill" Opacity="0.5" />
                                                    <TextBlock Text="📱" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
                                                    <StackPanel VerticalAlignment="Top" Margin="0,24,0,0">
                                                        <TextBlock x:Name="PhoneNameLabel" Text="Samsung Galaxy S24" FontFamily="Rajdhani" FontSize="16" FontWeight="SemiBold" Foreground="#DFDFDF" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="System Synced" FontFamily="JetBrains Mono" FontSize="10" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    
                                </StackPanel>

                                <!-- Col 2: System Status -->
                                <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                    <Border Style="{StaticResource GlassCard}" Padding="24" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="MOBILE STATUS" FontFamily="Rajdhani" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,16"/>
                                            <!-- Wi-Fi -->
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="📶 Wi-Fi" Foreground="#DFDFDF"/>
                                                <TextBlock x:Name="WifiLabel" Grid.Column="1" Text="—" Foreground="#FFFFFF" FontFamily="JetBrains Mono" FontSize="12"/>
                                            </Grid>
                                            <!-- Battery -->
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="🔋 Battery" Foreground="#DFDFDF"/>
                                                <TextBlock x:Name="BatteryLabel" Grid.Column="1" Text="—%" Foreground="#DFDFDF" FontFamily="JetBrains Mono" FontSize="12"/>
                                            </Grid>
                                            <!-- Ringer Mode -->
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Ringer" Foreground="#DFDFDF"/>
                                                <TextBlock x:Name="MobileRingerLabel" Grid.Column="1" Text="🔔 Ring" Foreground="#FFFFFF" FontFamily="JetBrains Mono" FontSize="12"/>
                                            </Grid>
                                            <!-- Phone Volume (media) -->
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="🔊 Media Vol" Foreground="#DFDFDF"/>
                                                <TextBlock x:Name="MobileVolumeLabel" Grid.Column="1" Text="—%" Foreground="#FFFFFF" FontFamily="JetBrains Mono" FontSize="12"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Content="−" Style="{StaticResource IconButton}" Click="VolDecrement_Click" Foreground="#848484" FontSize="18" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Slider Grid.Column="1" x:Name="MobileMediaVolSlider" Minimum="0" Maximum="100" PreviewMouseUp="MobileMediaVol_MouseUp" VerticalAlignment="Center"/>
                                                <Button Grid.Column="2" Content="+" Style="{StaticResource IconButton}" Click="VolIncrement_Click" Foreground="#848484" FontSize="18" Width="24" Height="24" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </Grid>
                                            <!-- Ringer Volume -->
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="🔔 Ringer Vol" Foreground="#DFDFDF"/>
                                                <TextBlock x:Name="MobileRingerVolLabel" Grid.Column="1" Text="—%" Foreground="#FFFFFF" FontFamily="JetBrains Mono" FontSize="12"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Content="−" Style="{StaticResource IconButton}" Click="RingerVolDecrement_Click" Foreground="#848484" FontSize="18" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Slider Grid.Column="1" x:Name="MobileRingerVolSlider" Minimum="0" Maximum="100" PreviewMouseUp="MobileRingerVol_MouseUp" VerticalAlignment="Center"/>
                                                <Button Grid.Column="2" Content="+" Style="{StaticResource IconButton}" Click="RingerVolIncrement_Click" Foreground="#848484" FontSize="18" Width="24" Height="24" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </Grid>

                                            <!-- Brightness -->
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="💡 Brightness" Foreground="#DFDFDF"/>
                                                <TextBlock x:Name="MobileBrightnessLabel" Grid.Column="1" Text="—%" Foreground="#FFFFFF" FontFamily="JetBrains Mono" FontSize="12"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Content="−" Style="{StaticResource IconButton}" Click="BrightnessDecrement_Click" Foreground="#848484" FontSize="18" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Slider Grid.Column="1" x:Name="MobileBrightnessSlider" Minimum="0" Maximum="100" PreviewMouseUp="MobileBrightness_MouseUp" VerticalAlignment="Center"/>
                                                <Button Grid.Column="2" Content="+" Style="{StaticResource IconButton}" Click="BrightnessIncrement_Click" Foreground="#848484" FontSize="18" Width="24" Height="24" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </Grid>
                                            <!-- Active Notifications -->
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="🔔 Notifications" Foreground="#DFDFDF"/>
                                                <TextBlock x:Name="MobileNotifCountLabel" Grid.Column="1" Text="0" Foreground="#FFFFFF" FontFamily="JetBrains Mono" FontSize="12"/>
                                            </Grid>

                                            <!-- Ringer Control Buttons -->
                                            <TextBlock Text="SET RINGER" FontFamily="Rajdhani" FontSize="11" FontWeight="Bold" Foreground="#848484" Margin="0,16,0,8"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <Button x:Name="RingerSilentBtn" Content="🔇 Silent" Background="#0DFFFFFF" BorderThickness="0" Margin="0,0,4,0" Padding="10,6" Opacity="0.4" Click="RingerSilent_Click" Cursor="Hand">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                                </Button>
                                                <Button x:Name="RingerVibrateBtn" Content="📳 Vibrate" Background="#0DFFFFFF" BorderThickness="0" Margin="0,0,4,0" Padding="10,6" Opacity="0.4" Click="RingerVibrate_Click" Cursor="Hand">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                                </Button>
                                                <Button x:Name="RingerRingBtn" Content="🔔 Ring" Background="#0DFFFFFF" BorderThickness="0" Padding="10,6" Opacity="1.0" Click="RingerRing_Click" Cursor="Hand">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource GlassCard}" Padding="24" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="REMOTE OVERRIDES" FontFamily="Rajdhani" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,16"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,12">
                                                <Button x:Name="LockBtn" Content="🔒 Lock Screen" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Width="100" Click="LockBtn_Click"/>
                                                <Button x:Name="CameraBtn" Content="📷 Camera" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Width="90" Click="CameraBtn_Click"/>
                                                <Button x:Name="ScreenShareBtn" Content="🖥️ Share" Style="{StaticResource PrimaryButton}" Width="85" Click="ScreenShareBtn_Click"/>
                                            </StackPanel>
                                            <Button x:Name="MuteBtn" Content="Mute Audio" Style="{StaticResource PrimaryButton}" Click="MuteBtn_Click" Margin="0,0,0,12"/>
                                            <Border Background="#0DFFFFFF" CornerRadius="8" Padding="16">
                                                <StackPanel>
                                                    <TextBlock x:Name="NowPlayingTitle" Text="Not Playing" Foreground="#DFDFDF" FontWeight="SemiBold" FontSize="14"/>
                                                    <TextBlock x:Name="NowPlayingArtist" Foreground="#BBBBBB" FontSize="12" Margin="0,2,0,12"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Button Content="⏮" Style="{StaticResource IconButton}" Click="Prev_Click" FontSize="18" Foreground="#BBBBBB" Width="40" Height="40"/>
                                                        <Button x:Name="PlayPauseBtn" Content="⏯" Style="{StaticResource IconButton}" Click="PlayPause_Click" FontSize="24" Foreground="#FFFFFF" Width="48" Height="48" Margin="8,0"/>
                                                        <Button Content="⏭" Style="{StaticResource IconButton}" Click="Next_Click" FontSize="18" Foreground="#BBBBBB" Width="40" Height="40"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    
                                    <Button x:Name="MusicBtn" Content="FORCE SYSTEM SYNC" FontFamily="Rajdhani" FontWeight="Bold" FontSize="14" Background="#FFFFFF" Foreground="#000000" Height="56" Click="MusicBtn_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="12"/>
                                            </Style>
                                        </Button.Resources>
                                        <Button.Effect>
                                            <DropShadowEffect Color="#FFFFFF" BlurRadius="20" ShadowDepth="0" Opacity="0.2"/>
                                        </Button.Effect>
                                    </Button>
                                    <!-- SMS Thread count badge -->
                                    <Border x:Name="SmsCountBadge" Background="#0DFFFFFF" CornerRadius="8" Padding="12,6" Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💬 " Foreground="#FFFFFF" FontSize="14"/>
                                            <TextBlock x:Name="SmsThreadCount" Text="0" Foreground="#FFFFFF" FontFamily="JetBrains Mono" FontSize="14"/>
                                            <TextBlock Text=" conversations" Foreground="#848484" FontSize="12" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Col 3: Notifications -->
                                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                    <Border Style="{StaticResource GlassCard}" Padding="24">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
                                                <TextBlock Text="ACTIVE NOTIFICATIONS" FontFamily="Rajdhani" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                <Border Background="#33FFFFFF" CornerRadius="8" Padding="6,2" Margin="8,0,0,0">
                                                    <TextBlock x:Name="NotifCount" Text="0" FontSize="10" Foreground="#FFFFFF" FontWeight="Bold"/>
                                                </Border>
                                                <Button Content="Clear" Style="{StaticResource IconButton}" Click="ClearNotifs_Click" Foreground="#848484" FontSize="10" Margin="16,0,0,0" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500">
                                                <ItemsControl x:Name="NotifList" ItemsSource="{Binding Notifications}" ItemTemplate="{StaticResource NotifTemplate}"/>
                                            </ScrollViewer>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 1: Messages -->
                    <TabItem>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Thread list -->
                            <Border Grid.Column="0" BorderBrush="#1AFFFFFF" BorderThickness="0,0,1,0" Background="#121212">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Padding="24" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="MESSAGES" FontWeight="Bold" FontSize="16" FontFamily="Rajdhani, Segoe UI" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                            <Button Content="Load" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" Click="LoadMessages_Click" ToolTip="Fetch SMS from phone"/>
                                        </StackPanel>
                                    </Border>
                                    <ListBox x:Name="SmsThreadList" Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource SmsThreadTemplate}" SelectionChanged="SmsThread_Selected"/>
                                </DockPanel>
                            </Border>
                            <!-- Conversation -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Padding="24" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1" Background="#121212">
                                    <TextBlock x:Name="ConversationHeader" Text="Select a conversation" FontWeight="SemiBold" FontSize="16" Foreground="#DFDFDF"/>
                                </Border>
                                <ScrollViewer Grid.Row="1" x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto" Padding="24">
                                    <ItemsControl x:Name="MessagesList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,6">
                                                    <Border CornerRadius="12" Padding="16,12" MaxWidth="400" HorizontalAlignment="{Binding IsSent, Converter={StaticResource BoolToAlignment}}">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{Binding IsSent, Converter={StaticResource BoolToColor}}"/>
                                                        </Border.Background>
                                                        <TextBlock Text="{Binding Body}" TextWrapping="Wrap" Foreground="White" FontSize="14"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Border Grid.Row="2" Padding="24" BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0" Background="#121212">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#1A1A1A" CornerRadius="12" BorderBrush="#333333" BorderThickness="1" Padding="16,12" Margin="0,0,12,0">
                                            <TextBox x:Name="ReplyBox" Background="Transparent" BorderThickness="0" Foreground="#DFDFDF" FontSize="14" AcceptsReturn="False" Text="" VerticalAlignment="Center"/>
                                        </Border>
                                        <Button Grid.Column="1" Content="Send" Style="{StaticResource PrimaryButton}" Click="SendSms_Click"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- TAB 2: Photos -->
                    <TabItem>
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="32,24" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1" Background="#121212">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="PHONE GALLERY" FontWeight="Bold" FontSize="20" FontFamily="Rajdhani, Segoe UI" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    <Button Content="Albums" Style="{StaticResource PrimaryButton}" Margin="24,0,0,0" Click="ShowAlbums_Click"/>
                                    <Button Content="Photos" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="ShowPhotos_Click"/>
                                    <Button Content="Refresh" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="RefreshPhotos_Click"/>
                                </StackPanel>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32">
                                <StackPanel>
                                    <WrapPanel x:Name="AlbumsPanel" Visibility="Collapsed"/>
                                    <WrapPanel x:Name="PhotosPanel" Visibility="Visible"/>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <!-- TAB 3: Apps -->
                    <TabItem>
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="32,24" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1" Background="#121212">
                                <TextBlock Text="APP LAUNCHER" FontWeight="Bold" FontSize="20" FontFamily="Rajdhani, Segoe UI" Foreground="#FFFFFF"/>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32">
                                <WrapPanel x:Name="AppsPanel" HorizontalAlignment="Left"/>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <!-- TAB 4: Clipboard -->
                    <TabItem>
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="32,24" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1" Background="#121212">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="CLIPBOARD SYNC" FontWeight="Bold" FontSize="20" FontFamily="Rajdhani, Segoe UI" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    <Button Content="Pull from Phone" Style="{StaticResource PrimaryButton}" Margin="24,0,0,0" Click="PullClipboard_Click"/>
                                </StackPanel>
                            </Border>
                            <StackPanel DockPanel.Dock="Top" Margin="32,24,32,0">
                                <Border Style="{StaticResource GlassCard}" Padding="24">
                                    <StackPanel>
                                        <TextBlock Text="Send text to phone clipboard:" Foreground="#BBBBBB" FontSize="14" Margin="0,0,0,12"/>
                                        <TextBox x:Name="ClipboardInput" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" Foreground="#DFDFDF" Padding="16" Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>
                                        <Button Content="Push to Phone" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" HorizontalAlignment="Right" Click="PushClipboard_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32">
                                <ItemsControl x:Name="ClipboardList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,12" Padding="16">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Content}" Foreground="#DFDFDF" TextWrapping="Wrap" MaxHeight="80" TextTrimming="CharacterEllipsis" FontSize="14"/>
                                                    <Button Grid.Column="1" Content="Copy" Margin="16,0,0,0" Style="{StaticResource PrimaryButton}" Tag="{Binding Content}" Click="CopyClipItem_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <!-- TAB 5: Chat -->
                    <TabItem>
                        <views:ChatView x:Name="ChatViewControl"
                                        xmlns:views="clr-namespace:NexLink.Views"/>
                    </TabItem>

                    <!-- TAB 6: Settings -->
                    <TabItem>
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="32,24" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1" Background="#121212">
                                <TextBlock Text="SETTINGS" FontWeight="Bold" FontSize="20" FontFamily="Rajdhani, Segoe UI" Foreground="#FFFFFF"/>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32">
                                <StackPanel>
                                    <TextBlock Text="ACCOUNT SYSTEM" Foreground="#FFFFFF" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="300"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- QR Code Panel -->
                                        <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="24" Margin="0,0,24,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Pair a New Device" Foreground="#DFDFDF" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,16" HorizontalAlignment="Center"/>
                                                <Border Background="#FFFFFF" Padding="8" CornerRadius="8" HorizontalAlignment="Center">
                                                    <Image Source="{Binding QrCodeImage}" Width="160" Height="160" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                </Border>
                                                <TextBlock Text="Scan this QR code using the NexLink app on your mobile device." Foreground="#848484" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,16,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Trusted Devices -->
                                        <Border Grid.Column="1" Style="{StaticResource GlassCard}" Padding="24">
                                            <StackPanel>
                                                <TextBlock Text="Trusted Devices" Foreground="#DFDFDF" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,16"/>
                                                <ItemsControl ItemsSource="{Binding TrustedDevices}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#1AFFFFFF" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                                                                        <TextBlock Text="📱" Margin="0,0,12,0"/>
                                                                        <TextBlock Text="{Binding}" Foreground="#DFDFDF" FontSize="14" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                    <Button Grid.Column="1" Content="Remove" Foreground="#FF5F56" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="12"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Border>

        <!-- DISCONNECTED OVERLAY (w01_qr_connection design) -->
        <Grid x:Name="DisconnectedOverlay" Visibility="Visible" Background="Transparent">
            <!-- Custom Title Bar -->
            <Border VerticalAlignment="Top" Height="48" Background="#111111" BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" Padding="16,0">
                <Grid>
                    <!-- Mac-like controls and Title -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <Border Width="14" Height="14" CornerRadius="7" Background="#FF5F56" BorderBrush="#1A000000" BorderThickness="1" Margin="0,0,6,0"/>
                            <Border Width="14" Height="14" CornerRadius="7" Background="#FFBD2E" BorderBrush="#1A000000" BorderThickness="1" Margin="0,0,6,0"/>
                            <Border Width="14" Height="14" CornerRadius="7" Background="#27C93F" BorderBrush="#1A000000" BorderThickness="1"/>
                        </StackPanel>
                        <TextBlock Text="NEXLINK" FontFamily="Rajdhani, Segoe UI" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                    
                    <!-- Standard Windows Controls -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="─" Style="{StaticResource IconButton}" Click="Minimize_Click" Foreground="#848484" FontSize="14" Width="32" Height="32"/>
                        <Button Content="✕" Style="{StaticResource IconButton}" Click="Close_Click" Foreground="#848484" FontSize="13" Width="32" Height="32"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Radial Background Glow -->
            <Border Width="800" Height="800" CornerRadius="400" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush>
                        <GradientStop Color="#0A000000" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <!-- Main Connection Card -->
            <Border Width="480" Height="560" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12" BorderBrush="#1AFFFFFF" BorderThickness="1" Margin="0,48,0,0">
                <Border.Background>
                    <SolidColorBrush Color="#1B1B1B" Opacity="0.6"/>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#FFFFFF" BlurRadius="40" ShadowDepth="0" Opacity="0.15"/>
                </Border.Effect>
                
                <Grid Margin="40">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Header -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <TextBlock Text="⇄" FontFamily="Segoe UI Symbol" FontSize="32" Foreground="#FFFFFF" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="NEXLINK" FontFamily="Rajdhani, Segoe UI" FontSize="40" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Waiting for mobile connection..." FontFamily="Nunito, Segoe UI" FontSize="16" Foreground="#848484" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- QR Area -->
                    <Grid Grid.Row="1" Width="260" Height="260" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Corner Brackets -->
                        <Border BorderBrush="#FFFFFF" BorderThickness="4,4,0,0" CornerRadius="8,0,0,0" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Border BorderBrush="#FFFFFF" BorderThickness="0,4,4,0" CornerRadius="0,8,0,0" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        <Border BorderBrush="#FFFFFF" BorderThickness="4,0,0,4" CornerRadius="0,0,0,8" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                        <Border BorderBrush="#FFFFFF" BorderThickness="0,0,4,4" CornerRadius="0,0,8,0" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        
                        <!-- Inner White QR Background -->
                        <Border Background="White" CornerRadius="6" Width="220" Height="220" Padding="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="QrCodeImage" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform"/>
                        </Border>
                        
                        <!-- Scan Line -->
                        <Border Height="2" Width="240" Background="#66FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ScanLineTransform" Y="-100"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect Color="#FFFFFF" BlurRadius="10" ShadowDepth="0" Opacity="1"/>
                            </Border.Effect>
                            <!-- NOTE: A storyboard animation could be added here for the scanning effect -->
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-100" To="100" Duration="0:0:1.5">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                    </Grid>

                    <!-- Bottom Status Area -->
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                        <Border Background="#2A2A2A" BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="8" Padding="24,12" Margin="0,0,0,24">
                            <TextBlock FontFamily="Nunito, Segoe UI" FontSize="16" Foreground="#DFE2F3" HorizontalAlignment="Center">
                                <Run Text="Open "/>
                                <Run Text="NexLink" Foreground="#FFFFFF" FontWeight="Bold"/>
                                <Run Text=" on Android and tap "/>
                                <Run Text="Scan QR" FontWeight="SemiBold"/>
                            </TextBlock>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Border Background="#1AFFFFFF" CornerRadius="16" Padding="12,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="#FFFFFF" Margin="0,0,8,0">
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:1"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                    <TextBlock Text="Server running" FontFamily="JetBrains Mono, Consolas" FontSize="14" Foreground="#FFFFFF"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="·" FontFamily="JetBrains Mono, Consolas" FontSize="14" Foreground="#848484" Margin="12,0"/>
                            
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Cloud Relay ID: " FontFamily="JetBrains Mono, Consolas" FontSize="14" Foreground="#848484"/>
                                <TextBlock Text="{Binding PairId}" FontFamily="JetBrains Mono, Consolas" FontSize="14" Foreground="#FFFFFF" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Bottom Actions -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="32">
                <Button BorderBrush="#FFFFFF" BorderThickness="1" Background="Transparent" Foreground="#FFFFFF" Padding="16,8" Margin="0,0,16,0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="?" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="TROUBLESHOOTING" FontFamily="Rajdhani, Segoe UI" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Background="#2A2A2A" BorderBrush="#1AFFFFFF" BorderThickness="1" Foreground="#DFE2F3" Padding="16,8" Cursor="Hand" Click="Settings_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="SETTINGS" FontFamily="Rajdhani, Segoe UI" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Text="Powered by Phynex" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="32,0,0,32" Foreground="#33FFFFFF" FontSize="11" FontFamily="Segoe UI"/>
        </Grid>
        <!-- NOTIFICATION POPUP OVERLAY -->
        <Border x:Name="NotifPopup" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,60,32,0" Width="320" CornerRadius="12" BorderBrush="#44FFFFFF" BorderThickness="1" Background="#111111" Padding="16">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="32" Height="32" Background="#3D5AFE" CornerRadius="8">
                    <TextBlock Text="📱" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0">
                    <TextBlock x:Name="PopupTitle" Text="New Notification" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="PopupBody" Text="Message content here..." Foreground="#B0B0B0" FontSize="12" TextWrapping="Wrap" MaxHeight="60"/>
                </StackPanel>
                <Button Grid.Column="2" Content="✕" Style="{StaticResource IconButton}" Click="ClosePopup_Click" VerticalAlignment="Top"/>
            </Grid>
        </Border>
    </Grid>
</Window>
